FROM php:8.4-fpm

# ca-certificates はベースイメージにも入っているが、ここで最新版に更新する
# (2026年10月の eMudhra 中間CA鍵の漏えいで、古い版は偽の証明書を受け入れてしまう)
RUN apt-get update && apt-get install -y \
    ca-certificates git unzip sqlite3 libsqlite3-dev \
    && pecl install xdebug \
    && docker-php-ext-enable xdebug

COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /var/www

COPY ./xdebug-fpm.ini /usr/local/etc/php/conf.d/xdebug.ini

ENTRYPOINT ["bash", "entrypoint-fpm.sh"]
